.tox/

# IDEs
# Eclipse
.classpath
.project
.settings/
.factorypath
# Intellij
.idea/
# ms vscode
.vscode/
# coding agents (local settings may contain machine paths)
.claude/

# Builds
dist/

# Local dev tools (OPA CLI, etc.)
/.tools/

# Local-only perf/capacity testing against real (non-public) policies —
# never published; see docs/capacity_planning.md for the shareable findings.
/tests/perf/
/scripts/build_perf_fixtures.py

# Secrets / credentials — never commit
.env
.env.*
*.pem
*.key
